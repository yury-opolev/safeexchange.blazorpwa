@page "/users/{Upn}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using SafeExchange.Client.Common
@using SafeExchange.Client.Common.Helpers
@using SafeExchange.Client.Common.Model
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication

@inject ApiClient apiClient
@inject NavigationManager NavManager

<ConfirmDialog @ref="this.confirmDialog" />

<div class="d-flex align-items-center mb-3">
    <button type="button" class="btn btn-outline-light" @onclick="this.GoToList">
        <i class="bi bi-arrow-left me-1"></i> Back to users
    </button>
    <h3 class="ms-3 mb-0">
        <i class="bi bi-person"></i>
        @(this.user?.DisplayName ?? this.Upn)
    </h3>
    @if (this.user is not null)
    {
        <span class="admin-pill @(this.user.Enabled ? "ok" : "off") ms-3">
            @(this.user.Enabled ? "enabled" : "disabled")
        </span>
        <button type="button"
                class="btn btn-sm @(this.user.Enabled ? "btn-outline-warning" : "btn-outline-success") ms-3"
                disabled="@this.toggling"
                @onclick="this.ToggleAsync">
            @if (this.toggling)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            @(this.user.Enabled ? "Disable" : "Enable")
        </button>
    }
</div>

@if (this.loading) { <div class="text-muted"><i class="spinner-border spinner-border-sm me-2"></i>Loading…</div> }
@if (!string.IsNullOrEmpty(this.error)) { <div class="alert alert-warning">@this.error</div> }

@if (this.user is not null)
{
    <div class="admin-card flex-column align-items-stretch">
        <dl class="row mb-0">
            <dt class="col-sm-3">UPN</dt>
            <dd class="col-sm-9"><code>@this.user.AadUpn</code></dd>

            <dt class="col-sm-3">Display name</dt>
            <dd class="col-sm-9">@this.user.DisplayName</dd>

            <dt class="col-sm-3">Contact email</dt>
            <dd class="col-sm-9">@this.user.ContactEmail</dd>

            <dt class="col-sm-3">User Id</dt>
            <dd class="col-sm-9"><code>@this.user.Id</code></dd>

            <dt class="col-sm-3">Entra object id</dt>
            <dd class="col-sm-9"><code>@this.user.AadObjectId</code></dd>

            <dt class="col-sm-3">Entra tenant id</dt>
            <dd class="col-sm-9"><code>@this.user.AadTenantId</code></dd>

            <dt class="col-sm-3">Created</dt>
            <dd class="col-sm-9">@this.user.CreatedAt.ToString("u")</dd>

            <dt class="col-sm-3">Last modified</dt>
            <dd class="col-sm-9">@this.user.ModifiedAt.ToString("u")</dd>

            <dt class="col-sm-3">External notifications</dt>
            <dd class="col-sm-9">@(this.user.ReceiveExternalNotifications ? "on" : "off")</dd>

            <dt class="col-sm-3">Consent required</dt>
            <dd class="col-sm-9">@(this.user.ConsentRequired ? "yes" : "no")</dd>

            <dt class="col-sm-3">MCP (user's choice)</dt>
            <dd class="col-sm-9">
                @(this.user.McpAllowed ? "allowed" : "not allowed")
                <span class="text-muted small">— set by the user, read-only here</span>
            </dd>

            <dt class="col-sm-3">MCP access</dt>
            <dd class="col-sm-9 d-flex align-items-center">
                <span class="admin-pill @McpStatus.AdminPillClass(this.user.McpAllowed, this.user.McpBlockedByAdmin)">@McpStatus.Label(this.user.McpAllowed, this.user.McpBlockedByAdmin)</span>
                <button type="button"
                        class="btn btn-sm @(this.user.McpBlockedByAdmin ? "btn-outline-success" : "btn-outline-warning") ms-3"
                        disabled="@this.togglingMcp"
                        @onclick="this.ToggleMcpBlockedAsync">
                    @if (this.togglingMcp)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    @(this.user.McpBlockedByAdmin ? "Unblock MCP" : "Block MCP")
                </button>
            </dd>

            <dt class="col-sm-3">Telemetry id (current)</dt>
            <dd class="col-sm-9">
                @if (string.IsNullOrEmpty(this.user.CurrentTelemetryId))
                {
                    <span class="text-muted">—</span>
                }
                else
                {
                    <code>@this.user.CurrentTelemetryId</code>
                    <div class="text-muted small">
                        active since @this.user.TelemetryIdActiveSinceUtc.ToString("u"), rotates after @this.user.TelemetryIdRotatesAtUtc.ToString("u")
                    </div>
                }
            </dd>

            <dt class="col-sm-3">Recent telemetry ids</dt>
            <dd class="col-sm-9">
                @if (this.user.RecentTelemetryIds.Count == 0)
                {
                    <span class="text-muted">none retained (within 28 days)</span>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th>Telemetry id</th><th>Active from</th><th>Active to</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var w in this.user.RecentTelemetryIds)
                            {
                                <tr>
                                    <td><code>@w.Id</code></td>
                                    <td class="text-muted">@w.ValidFromUtc.ToString("u")</td>
                                    <td class="text-muted">@w.ValidToUtc.ToString("u")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </dd>
        </dl>
    </div>
}

@code {
    [Parameter] public string Upn { get; set; } = string.Empty;

    private UserDetail? user;
    private bool loading;
    private bool toggling;
    private bool togglingMcp;
    private string? error;
    private ConfirmDialog? confirmDialog;

    protected override Task OnInitializedAsync() => this.FetchAsync();

    private async Task FetchAsync()
    {
        this.loading = true;
        this.error = null;
        try
        {
            var resp = await this.apiClient.GetUserDetailAsync(this.Upn);
            if ("ok".Equals(resp.Status))
            {
                this.user = resp.Result;
            }
            else
            {
                this.error = resp.Error ?? resp.Status;
            }
        }
        catch (AccessTokenNotAvailableException ex)
        {
            ex.Redirect();
        }
        finally
        {
            this.loading = false;
        }
    }

    private async Task ToggleAsync()
    {
        if (this.user is null || this.confirmDialog is null)
        {
            return;
        }

        var willEnable = !this.user.Enabled;
        var ok = await this.confirmDialog.ShowAsync(
            title: willEnable ? "Enable user" : "Disable user",
            body: $"{(willEnable ? "Enable" : "Disable")} user '{this.user.AadUpn}'?",
            confirmLabel: willEnable ? "Enable" : "Disable",
            confirmButtonClass: willEnable ? "btn-success" : "btn-warning");
        if (!ok)
        {
            return;
        }

        this.toggling = true;
        this.error = null;
        try
        {
            var resp = await this.apiClient.SetUserEnabledAsync(this.user.AadUpn, willEnable);
            if ("ok".Equals(resp.Status) && resp.Result is not null)
            {
                this.user.Enabled = resp.Result.Enabled;
            }
            else
            {
                this.error = resp.Error ?? resp.Status;
            }
        }
        catch (AccessTokenNotAvailableException ex)
        {
            ex.Redirect();
        }
        finally
        {
            this.toggling = false;
        }
    }

    private async Task ToggleMcpBlockedAsync()
    {
        if (this.user is null || this.confirmDialog is null)
        {
            return;
        }

        var willBlock = !this.user.McpBlockedByAdmin;
        var ok = await this.confirmDialog.ShowAsync(
            title: willBlock ? "Block MCP" : "Unblock MCP",
            body: willBlock
                ? $"Block MCP for user '{this.user.AadUpn}'? AI agents are refused for this user even if they allowed MCP."
                : $"Unblock MCP for user '{this.user.AadUpn}'? MCP stays off until the user allows it.",
            confirmLabel: willBlock ? "Block MCP" : "Unblock MCP",
            confirmButtonClass: willBlock ? "btn-warning" : "btn-success");
        if (!ok)
        {
            return;
        }

        this.togglingMcp = true;
        this.error = null;
        try
        {
            var resp = await this.apiClient.SetUserMcpBlockedAsync(this.user.AadUpn, willBlock);
            if ("ok".Equals(resp.Status) && resp.Result is not null)
            {
                this.user.McpAllowed = resp.Result.McpAllowed;
                this.user.McpBlockedByAdmin = resp.Result.McpBlockedByAdmin;
            }
            else
            {
                this.error = resp.Error ?? resp.Status;
            }
        }
        catch (AccessTokenNotAvailableException ex)
        {
            ex.Redirect();
        }
        finally
        {
            this.togglingMcp = false;
        }
    }

    private void GoToList() => this.NavManager.NavigateTo("users");
}
